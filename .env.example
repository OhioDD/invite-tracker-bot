DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
MAIN_GUILD_ID=server_a_id_here
CLAIM_GUILD_ID=server_b_id_here
DATABASE_URL=your_neon_database_url_here

# Ollama Cloud (https://ollama.com/settings/keys) — NOT local Ollama
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
# Vision + free tier: gemma3:12b-cloud or gemma3:4b-cloud
# Pro only: gemini-3-flash-preview:cloud
OLLAMA_CLOUD_MODEL=gemma3:12b-cloud
